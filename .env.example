# =============================================
# Distributed Sync System - Environment Config
# =============================================

# Node Identity
NODE_ID=node1
NODE_HOST=0.0.0.0
NODE_PORT=8001

# Cluster Peers (comma-separated URLs, exclude self)
PEER_NODES=http://node2:8002,http://node3:8003

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Raft Consensus Timing (seconds)
ELECTION_TIMEOUT_MIN=0.15
ELECTION_TIMEOUT_MAX=0.30
HEARTBEAT_INTERVAL=0.05

# Distributed Lock
LOCK_TIMEOUT=30.0
DEADLOCK_CHECK_INTERVAL=5.0

# Distributed Queue
QUEUE_MAX_SIZE=10000
MESSAGE_RETRY_INTERVAL=5.0
MESSAGE_MAX_RETRIES=3
VIRTUAL_NODES=150

# Cache
CACHE_SIZE=1000

# Security (Bonus D)
TLS_ENABLED=false
TLS_CERT_FILE=security/certs/node.crt
TLS_KEY_FILE=security/certs/node.key
AUDIT_LOG_FILE=logs/audit.log
API_KEY=dev-secret-key-change-in-prod

# Logging
LOG_LEVEL=INFO
